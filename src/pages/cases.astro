---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import CaseCard from '../components/ui/CaseCard.astro';
import { CASES } from '../data/cases';
import { RESULT_SUMMARY } from '../data/results';

const groups = [
  { label: 'Excel / GAS', value: 'excel' as const },
  { label: '業務システム構築', value: 'system' as const },
  { label: 'RPA導入', value: 'rpa' as const },
];
---

<BaseLayout
  title="事例紹介"
  description="Excel自動化、RPA、業務システム構築の代表的な事例と効果。月10〜30時間の作業時間削減につながったケースをご紹介します。"
>
  <section class="bg-paper-soft border-b border-line">
    <Container class="py-16 md:py-20">
      <p class="eyebrow">Cases</p>
      <h1 class="mt-3 text-balance text-4xl font-bold leading-[1.2] tracking-tight md:text-5xl">事例紹介</h1>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[2] text-ink-soft">
        <span class="inline-block">過去にお手伝いした業務自動化の代表例です。</span>
        <span class="inline-block">{RESULT_SUMMARY.description}</span>
      </p>
    </Container>
  </section>

  {
    groups.map((g, idx) => {
      const items = CASES.filter((c) => c.service === g.value);
      if (items.length === 0) return null;
      return (
        <Section tone={idx % 2 === 0 ? 'paper' : 'paper-soft'} spacing="md">
          <Container>
            <div class="flex items-center gap-3">
              <span class="index-mono">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{g.label}</h2>
              <span class="ml-2 inline-flex items-center rounded-full bg-ink px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-paper-soft">
                {items.length}件
              </span>
            </div>
            <div class="mt-8 grid gap-6 md:grid-cols-2">
              {items.map((c) => (
                <CaseCard caseStudy={c} />
              ))}
            </div>
          </Container>
        </Section>
      );
    })
  }

</BaseLayout>
