---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CharacterMascot from '../components/ui/CharacterMascot.astro';
import PlanCard from '../components/ui/PlanCard.astro';
import PlanComparisonTable from '../components/ui/PlanComparisonTable.astro';
import { SERVICES } from '../data/services';
import { PLANS, PLAN_NOTES } from '../data/plans';
import { FLOW_STEPS, FLOW_NOTES } from '../data/flow';
import { COMPANY } from '../lib/site';
---

<BaseLayout
  title="サービス詳細"
  description="Excel・スプレッドシート作業の自動化、RPA導入、業務システム構築の3つのサービスと料金プランをご紹介します。"
>
  <!-- Page header -->
  <section class="bg-paper-soft border-b border-line">
    <Container class="py-16 md:py-20">
      <p class="eyebrow">Services</p>
      <h1 class="mt-3 text-balance text-4xl font-bold leading-[1.2] tracking-tight md:text-5xl">サービス詳細</h1>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[2] text-ink-soft">
        <span class="inline-block">Bearmin Studioが提供する</span><span class="inline-block">3つの業務改善軸と料金プラン。</span><br class="hidden md:block" />
        <span class="inline-block">毎月の制作枠の中で、</span><span class="inline-block">優先順位の高いものから着実に進めます。</span>
      </p>
      <nav aria-label="ページ内ナビゲーション" class="mt-8 flex flex-wrap gap-2 text-sm">
        {
          SERVICES.map((s) => (
            <a
              href={`#${s.id}`}
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-3.5 py-1.5 font-medium text-ink-soft transition-colors hover:border-ink/30 hover:text-ink"
            >
              <span class="font-mono text-[10px] text-accent-deep">{s.index}</span>
              {s.category}
            </a>
          ))
        }
        <a href="#pricing" class="inline-flex items-center rounded-full border border-line bg-paper px-3.5 py-1.5 font-medium text-ink-soft transition-colors hover:border-ink/30 hover:text-ink">
          料金プラン
        </a>
      </nav>
    </Container>
  </section>

  <!-- Each service block -->
  {
    SERVICES.map((service, i) => (
      <Section
        id={service.id}
        tone={i % 2 === 0 ? 'paper' : 'paper-soft'}
        spacing="lg"
      >
        <Container>
          <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:items-start">
            <div>
              <p class="font-mono text-xs tracking-[0.22em] text-accent-deep">{service.index} / {String(SERVICES.length).padStart(2, '0')}</p>
              <p class="mt-2 text-xs font-semibold uppercase tracking-[0.18em] text-accent-deep">{service.category}</p>
              <h2 class="mt-3 break-keep text-xl font-bold leading-[1.4] tracking-tight md:text-2xl lg:text-3xl"><Fragment set:html={service.title} /></h2>
              <p class="mt-4 break-keep text-pretty text-base font-medium text-ink-soft md:text-lg"></p>
              <p class="mt-6 text-pretty text-base leading-[2] text-ink-soft"><Fragment set:html={service.description} /></p>
            </div>
            <div class="hidden justify-end lg:flex">
              <CharacterMascot pose={service.mascot} alt="" size="lg" />
            </div>
          </div>

          <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-8">
            <div class="rounded-2xl border border-line bg-paper-soft p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-deep">対応例</p>
              <ul class="mt-5 grid gap-2 text-sm text-ink-soft sm:grid-cols-2">
                {service.examples.map((ex) => (
                  <li class="flex items-start gap-2">
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="mt-1 h-3.5 w-3.5 flex-none text-accent-deep">
                      <path
                        fill-rule="evenodd"
                        d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4l3.3 3.3 7.3-7.3a1 1 0 0 1 1.4 0Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{ex}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-2xl border border-line bg-paper-soft p-7">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">こんなお悩みに</p>
              <ul class="mt-5 space-y-2.5 text-sm text-ink-soft">
                {service.concerns.map((c) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-2 h-1 w-1 flex-none rounded-full bg-ink/40" aria-hidden="true" />
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </Container>
      </Section>
    ))
  }

  <!-- Pricing -->
  <Section tone="paper" spacing="lg" id="pricing">
    <Container>
      <SectionHeader
        eyebrow="Pricing"
        title="料金プラン"
        description="月額19,800円から始められる、3つのプラン。すべてのプランで初期費用0円。制作件数と改善相談の頻度に応じてお選びください。"
      />
      <div class="mt-14 grid gap-6 lg:grid-cols-3 lg:gap-8">
        {PLANS.map((plan) => <PlanCard plan={plan} />)}
      </div>

      <div class="mt-16">
        <h3 class="text-xl font-bold text-ink">プラン比較表</h3>
        <div class="mt-5"><PlanComparisonTable /></div>
      </div>

      <div class="mt-12 space-y-1.5 text-xs leading-relaxed text-ink-muted">
        <p>
          ※「1件」は、1つの目的に対する制作・改善を指します（例：売上管理表の改善／問い合わせ管理表の作成／業務システムの1機能追加 など）。<br />
          ※ボリュームが大きい案件は、ヒアリング時に件数調整・別途お見積りをご相談ください。
        </p>
        {
          PLAN_NOTES.map((note) => (
            <p>※ {note}</p>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ============================ -->
  <!-- Flow: ご契約までの流れ -->
  <!-- ============================ -->
  <Section tone="paper-soft" spacing="lg" id="flow">
    <Container>
      <SectionHeader
        eyebrow="Flow"
        title="ご契約までの流れ"
        description='<span class="inline-block">ご相談から提案・契約・制作・運用まで、</span><span class="inline-block">必要なやり取りはすべて Chatwork 上で。</span><span class="inline-block">対面の打ち合わせや電話は基本不要、</span><span class="inline-block">忙しい本業の合間でも進められます。</span>'
      />

      <!-- Timeline -->
      <ol class="mx-auto mt-12 max-w-3xl">
        {
          FLOW_STEPS.map((step, i) => (
            <li class="relative flex gap-5 md:gap-8">
              <div class="flex flex-col items-center">
                <span class="z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-line bg-paper-soft font-mono text-sm font-bold text-accent-deep shadow-[var(--shadow-soft)] md:h-14 md:w-14 md:text-base">
                  {step.index}
                </span>
                {i < FLOW_STEPS.length - 1 && <span class="w-px flex-1 bg-line" />}
              </div>
              <div class:list={['pb-10 md:pb-12', i === FLOW_STEPS.length - 1 && '!pb-0']}>
                <h3 class="break-keep text-balance text-lg font-bold tracking-tight md:text-xl">
                  {step.title}
                </h3>
                <p class="mt-2 text-pretty text-sm leading-[1.95] text-ink-soft md:text-[15px]">
                  {step.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Notes -->
      <div class="mx-auto mt-6 max-w-3xl space-y-1.5 border-t border-line pt-6 text-xs leading-relaxed text-ink-muted">
        {FLOW_NOTES.map((note) => <p>※ {note}</p>)}
      </div>

      <!-- CTA to contact -->
      <div class="mx-auto mt-10 max-w-3xl text-center">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper-soft transition-colors hover:bg-ink-soft"
        >
          Chatworkで相談する（{COMPANY.chatworkId}）
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4">
            <path
              fill-rule="evenodd"
              d="M7.21 14.77a.75.75 0 0 1 0-1.06L10.94 10 7.21 6.29a.75.75 0 1 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      </div>
    </Container>
  </Section>

</BaseLayout>
