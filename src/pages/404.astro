---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import CharacterMascot from '../components/ui/CharacterMascot.astro';
---

<BaseLayout title="ページが見つかりません" noindex>
  <section class="bg-paper">
    <Container class="flex flex-col items-center gap-10 py-24 text-center md:py-32">
      <CharacterMascot pose="peek" alt="" size="xl" />
      <div>
        <p class="index-mono">404 / Not Found</p>
        <h1 class="mt-3 text-balance text-3xl font-bold tracking-tight md:text-4xl">
          <span class="inline-block">お探しのページが</span><span class="inline-block">見つかりませんでした</span>
        </h1>
        <p class="mx-auto mt-4 max-w-md text-pretty text-sm leading-[1.95] text-ink-soft md:text-base">
          <span class="inline-block">URL が間違っているか、</span><span class="inline-block">ページが移動・削除された可能性があります。</span>
          <span class="inline-block">お手数ですが、</span><span class="inline-block">トップページからお探しください。</span>
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">トップへ戻る</Button>
        <Button href="/contact" variant="ghost" size="lg">お問い合わせ</Button>
      </div>
    </Container>
  </section>
</BaseLayout>
