---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import { COMPANY } from '../lib/site';

const sections = [
  {
    heading: '1. 取得する個人情報',
    body: 'お問い合わせフォーム等を通じて、以下の情報を取得します。',
    list: [
      'お名前',
      'メールアドレス',
      'ご希望のプラン（任意）',
      'ご相談内容・お問い合わせ内容',
      'その他お客様が自発的に提供される情報',
    ],
  },
  {
    heading: '2. 利用目的',
    body: '取得した個人情報は、以下の目的のために利用します。',
    list: [
      'お問い合わせへの返信・対応',
      'お見積りのご提示',
      'ご契約に関する手続き・連絡',
      'サービス提供および制作物の保守・運用',
    ],
  },
  {
    heading: '3. 第三者への提供',
    body: '取得した個人情報は、法令に基づく場合または本人の同意がある場合を除き、第三者に提供することはありません。',
  },
  {
    heading: '4. 安全管理措置',
    body: '個人情報への不正アクセス、紛失、改ざん、漏えい等を防止するため、必要かつ適切な安全管理措置を講じます。',
  },
  {
    heading: '5. 保有期間',
    body: '取得した個人情報は、利用目的の達成に必要な期間に限り保有し、不要となった情報は速やかに削除します。',
  },
  {
    heading: '6. 開示・訂正・削除のご請求',
    body: 'ご本人から個人情報の開示・訂正・削除等のご請求があった場合、本人確認のうえ、合理的な範囲で速やかに対応します。',
  },
  {
    heading: '7. クッキー（Cookie）等の利用',
    body: '当サイトはサービスの品質向上のため、アクセス解析等にクッキーを利用する場合があります。クッキーには個人を特定する情報は含まれません。',
  },
  {
    heading: '8. プライバシーポリシーの改定',
    body: '本ポリシーの内容は、必要に応じて改定することがあります。改定後の内容は本ページに掲載した時点で効力を生じます。',
  },
];
---

<BaseLayout
  title="プライバシーポリシー"
  description="Bearmin Studio のプライバシーポリシー。個人情報の取り扱いについてご案内します。"
>
  <section class="bg-paper-soft border-b border-line">
    <Container class="py-16 md:py-20">
      <p class="eyebrow">Privacy Policy</p>
      <h1 class="mt-3 text-balance text-4xl font-bold leading-[1.2] tracking-tight md:text-5xl">プライバシーポリシー</h1>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[2] text-ink-soft">
        {COMPANY.name}（以下「当方」）は、お客様の個人情報の重要性を認識し、適切な管理・保護に努めます。
      </p>
    </Container>
  </section>

  <Section tone="paper" spacing="md">
    <Container>
      <div class="mx-auto max-w-3xl space-y-10 text-sm leading-[2] text-ink-soft md:text-[15px]">
        {
          sections.map((s) => (
            <section>
              <h2 class="text-base font-bold text-ink md:text-lg">{s.heading}</h2>
              <p class="mt-3">{s.body}</p>
              {s.list && (
                <ul class="mt-3 space-y-1.5">
                  {s.list.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-ink/40" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <section>
          <h2 class="text-base font-bold text-ink md:text-lg">9. お問い合わせ窓口</h2>
          <p class="mt-3">個人情報の取り扱いに関するお問い合わせは、以下までご連絡ください。</p>
          <dl class="mt-4 grid gap-2 text-sm md:grid-cols-[120px_1fr]">
            <dt class="text-ink-muted">事業者</dt>
            <dd>{COMPANY.name}（{COMPANY.nameJa}）</dd>
            <dt class="text-ink-muted">代表者</dt>
            <dd>{COMPANY.owner}</dd>
            <dt class="text-ink-muted">所在地</dt>
            <dd>{COMPANY.address}</dd>
            <dt class="text-ink-muted">メール</dt>
            <dd>
              <a href={`mailto:${COMPANY.email}`} class="font-medium text-ink underline-offset-2 hover:underline">{COMPANY.email}</a>
            </dd>
          </dl>
        </section>

        <p class="border-t border-line pt-6 text-xs text-ink-muted">制定日: 2026年5月20日</p>
      </div>
    </Container>
  </Section>
</BaseLayout>
