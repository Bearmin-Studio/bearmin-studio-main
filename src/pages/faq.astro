---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import FaqItem from '../components/ui/FaqItem.astro';
import { FAQS, FAQ_CATEGORY_LABEL, type FaqCategory } from '../data/faqs';

const categories: FaqCategory[] = ['contract', 'plan', 'service', 'other'];

const groups = categories
  .map((cat) => ({
    cat,
    label: FAQ_CATEGORY_LABEL[cat],
    items: FAQS.filter((f) => f.category === cat),
  }))
  .filter((g) => g.items.length > 0);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title="よくあるご質問"
  description="Bearmin Studio のサービス・契約・プラン・お支払いについて、よくあるご質問をまとめました。"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <section class="bg-paper-soft border-b border-line">
    <Container class="py-16 md:py-20">
      <p class="eyebrow">FAQ</p>
      <h1 class="mt-3 text-balance text-4xl font-bold leading-[1.2] tracking-tight md:text-5xl">よくあるご質問</h1>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[2] text-ink-soft">
        <span class="inline-block">ご契約・サービス内容・プラン・お支払いについて、</span><span class="inline-block">特に多くいただくご質問をまとめました。</span>
        <span class="inline-block">ここに無いご質問は</span><span class="inline-block">お気軽にお問い合わせください。</span>
      </p>
    </Container>
  </section>

  <Section tone="paper" spacing="lg">
    <Container size="md">
      {
        groups.map((g) => (
          <div class="mb-14 last:mb-0">
            <h2 class="text-xl font-bold tracking-tight md:text-2xl">{g.label}</h2>
            <div class="mt-5 flex flex-col gap-3">
              {g.items.map((faq) => (
                <FaqItem question={faq.question} answer={faq.answer} />
              ))}
            </div>
          </div>
        ))
      }
    </Container>
  </Section>

</BaseLayout>
