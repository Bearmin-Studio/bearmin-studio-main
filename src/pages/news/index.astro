---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import CharacterMascot from '../../components/ui/CharacterMascot.astro';
import { fetchNewsList } from '../../lib/microcms';
import { NEWS_CATEGORY_LABEL } from '../../types/news';
import { formatDate } from '../../lib/date';

const { contents } = await fetchNewsList({ limit: 50 });
---

<BaseLayout title="お知らせ" description="Bearmin Studio からのお知らせ一覧。">
  <section class="bg-paper-soft border-b border-line">
    <Container class="py-16 md:py-20">
      <p class="eyebrow">News</p>
      <h1 class="mt-3 text-balance text-4xl font-bold leading-[1.2] tracking-tight md:text-5xl">お知らせ</h1>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[2] text-ink-soft">
        <span class="inline-block">サービスの更新、リリース情報、</span><span class="inline-block">メディア掲載などをお届けします。</span>
      </p>
    </Container>
  </section>

  <Section tone="paper" spacing="lg">
    <Container size="md">
      {
        contents.length === 0 ? (
          <div class="flex flex-col items-center gap-6 rounded-2xl border border-line bg-paper-soft px-6 py-16 text-center">
            <CharacterMascot pose="sleep" alt="" size="md" />
            <div>
              <p class="text-base font-semibold text-ink">現在、お知らせはありません。</p>
              <p class="mt-2 text-sm text-ink-muted">新しい情報は、こちらのページでお知らせします。</p>
            </div>
          </div>
        ) : (
          <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-paper-soft">
            {contents.map((item) => (
              <li>
                <a
                  href={`/news/${item.id}`}
                  class="flex flex-col gap-2 px-6 py-6 transition-colors hover:bg-line-soft md:flex-row md:items-center md:gap-6 md:px-8"
                >
                  <time class="font-mono text-xs text-ink-muted md:text-sm" datetime={item.publishedAt ?? item.createdAt}>
                    {formatDate(item.publishedAt ?? item.createdAt)}
                  </time>
                  <span class="inline-flex w-fit items-center rounded-full bg-line-soft px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
                    {NEWS_CATEGORY_LABEL[item.category] ?? 'お知らせ'}
                  </span>
                  <span class="flex-1 text-sm font-medium text-ink md:text-[15px]">{item.title}</span>
                  <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="hidden h-4 w-4 flex-none text-ink-subtle md:block">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 0-1.06L10.94 10 7.21 6.29a.75.75 0 1 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </Container>
  </Section>
</BaseLayout>
