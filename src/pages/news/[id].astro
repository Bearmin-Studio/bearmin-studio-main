---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import { fetchAllNewsIds, fetchNewsItem } from '../../lib/microcms';
import { NEWS_CATEGORY_LABEL } from '../../types/news';
import { formatDate } from '../../lib/date';

export async function getStaticPaths() {
  const ids = await fetchAllNewsIds();
  return ids.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const item = id ? await fetchNewsItem(id) : null;

if (!item) {
  return Astro.redirect('/news');
}
---

<BaseLayout
  title={item.title}
  description={item.excerpt ?? item.title}
  ogType="article"
  publishedTime={item.publishedAt ?? item.createdAt}
  modifiedTime={item.updatedAt ?? item.publishedAt ?? item.createdAt}
  articleSection="お知らせ"
>
  <section class="bg-paper-soft border-b border-line">
    <Container class="py-12 md:py-16">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <a href="/news" class="inline-flex items-center gap-1 text-ink-muted transition-colors hover:text-ink">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
            <path
              fill-rule="evenodd"
              d="M12.79 5.23a.75.75 0 0 1 0 1.06L9.06 10l3.73 3.71a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
              clip-rule="evenodd"
            />
          </svg>
          お知らせ一覧へ
        </a>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <time class="font-mono text-xs text-ink-muted md:text-sm" datetime={item.publishedAt ?? item.createdAt}>
          {formatDate(item.publishedAt ?? item.createdAt)}
        </time>
        <span class="inline-flex items-center rounded-full bg-ink px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-paper-soft">
          {NEWS_CATEGORY_LABEL[item.category] ?? 'お知らせ'}
        </span>
      </div>
      <h1 class="mt-4 text-balance text-3xl font-bold leading-[1.25] tracking-tight md:text-4xl">{item.title}</h1>
    </Container>
  </section>

  <Section tone="paper" spacing="md">
    <Container size="md">
      <article
        class="prose prose-neutral max-w-none text-base leading-[2] text-ink-soft [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-ink [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-ink [&_img]:rounded-xl [&_p]:my-4 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6"
        set:html={item.body}
      />

      <div class="mt-16 flex justify-center">
        <Button href="/news" variant="ghost">お知らせ一覧へ戻る</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
