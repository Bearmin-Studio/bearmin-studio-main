---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import CharacterMascot from '../components/ui/CharacterMascot.astro';
import { COMPANY, SITE } from '../lib/site';

const businessInfo = [
  { label: '屋号', value: `${COMPANY.name}（${COMPANY.nameJa}）` },
  { label: '代表者', value: COMPANY.owner },
  { label: '所在地', value: COMPANY.address },
  {
    label: '連絡先',
    value: null,
    items: [
      { kind: 'mail', label: 'メール', value: COMPANY.email, href: `mailto:${COMPANY.email}` },
      {
        kind: 'chatwork',
        label: 'Chatwork',
        value: COMPANY.chatworkId,
        href: COMPANY.chatworkUrl,
      },
      {
        kind: 'x',
        label: 'X',
        value: COMPANY.xHandle,
        href: COMPANY.xUrl,
      },
      { kind: 'phone', label: '電話番号', value: COMPANY.phoneNotice, href: null },
    ],
  },
  { label: '事業内容', value: COMPANY.business },
];
---

<BaseLayout
  title="事業概要"
  description="Bearmin Studio の事業者情報・連絡先・事業内容をご紹介します。"
>
  <section class="bg-paper-soft border-b border-line">
    <Container class="py-16 md:py-20">
      <p class="eyebrow">About</p>
      <h1 class="mt-3 text-balance text-4xl font-bold leading-[1.2] tracking-tight md:text-5xl">事業概要</h1>
      <p class="mt-5 max-w-2xl text-pretty text-base leading-[2] text-ink-soft">
        <span class="inline-block">Bearmin Studio は、</span><span class="inline-block">Excel・スプレッドシート作業の自動化、</span><span class="inline-block">業務システム構築、RPA導入を</span><span class="inline-block">月額制で提供する業務効率化サービスです。</span>
      </p>
    </Container>
  </section>

  <Section tone="paper" spacing="md">
    <Container>
      <SectionHeader
        eyebrow="Mission"
        title="時間と余裕を提供します。"
        description="Bearmin Studioは、Excel・スプレッドシート作業の自動化、業務システム構築、RPA導入を通じて、日々の手作業を減らす月額サービスを提供します。毎月着実に業務を改善しながら、作業時間や人件費の負担を削減し、事業者に余裕と時間を提供します。"
      />
    </Container>
  </Section>

  <Section tone="paper-soft" spacing="md">
    <Container>
      <SectionHeader eyebrow="Business Info" title="事業者情報" />
      <dl class="mt-10 mx-auto max-w-3xl overflow-hidden rounded-2xl border border-line bg-paper">
        {
          businessInfo.map((row, idx) => (
            <div class:list={['grid gap-2 px-6 py-5 md:grid-cols-[180px_1fr] md:gap-6 md:py-6', idx !== 0 && 'border-t border-line']}>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted md:text-sm md:normal-case md:tracking-normal md:text-ink-soft">
                {row.label}
              </dt>
              <dd class="text-sm leading-relaxed text-ink md:text-[15px]">
                {row.value && <p>{row.value}</p>}
                {row.items && (
                  <ul class="space-y-2">
                    {row.items.map((it) => (
                      <li class="flex flex-wrap items-baseline gap-x-3">
                        <span class="text-xs font-semibold text-ink-muted">{it.label}</span>
                        {it.href ? (
                          <a
                            href={it.href}
                            target={it.kind === 'chatwork' || it.kind === 'x' ? '_blank' : undefined}
                            rel={it.kind === 'chatwork' || it.kind === 'x' ? 'noopener noreferrer' : undefined}
                            class="break-all font-medium text-ink underline-offset-2 hover:underline"
                          >
                            {it.value}
                          </a>
                        ) : (
                          <span class="text-ink-soft">{it.value}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </Container>
  </Section>

</BaseLayout>
