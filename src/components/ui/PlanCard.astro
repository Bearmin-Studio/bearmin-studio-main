---
import type { Plan } from '../../data/plans';
import Button from './Button.astro';

type Props = {
  plan: Plan;
  highlightLine?: string;
};

const { plan, highlightLine } = Astro.props;
---

<article
  class:list={[
    'relative flex h-full flex-col rounded-2xl bg-paper-soft p-8 text-ink transition-colors',
    plan.recommended
      ? 'ring-2 ring-ink shadow-[var(--shadow-lift)]'
      : 'ring-1 ring-line hover:ring-ink/30',
  ]}
>
  {
    plan.recommended && (
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-ink">
        おすすめ
      </span>
    )
  }
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-deep">{plan.tagline}</p>
    <h3 class="mt-2 text-xl font-bold">{plan.name}</h3>
  </div>
  <div class="mt-6 flex items-baseline gap-1.5">
    <span class="text-2xl font-bold leading-none text-ink md:text-3xl">{plan.feeLabel}</span>
    <span class="text-xs text-ink-muted">/月（税込）</span>
  </div>
  <p class="mt-5 text-pretty text-sm leading-[1.9] text-ink-soft">{plan.description}</p>

  {
    highlightLine && (
      <p class="mt-4 inline-flex w-fit rounded-full bg-line-soft px-3 py-1 text-xs font-medium text-ink-soft">
        {highlightLine}
      </p>
    )
  }

  <div class="mt-6 border-t border-line pt-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">向いている方</p>
    <ul class="mt-3 space-y-2 text-sm">
      {
        plan.audienceDetail.map((a) => (
          <li class="flex items-start gap-2">
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
              class="mt-1 h-3.5 w-3.5 flex-none text-accent-deep"
            >
              <path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4l3.3 3.3 7.3-7.3a1 1 0 0 1 1.4 0Z"
                clip-rule="evenodd"
              />
            </svg>
            <span>{a}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-8 pt-1">
    <Button href={`/contact?plan=${plan.id}`} variant="primary" fullWidth size="md">
      このプランで相談する
    </Button>
  </div>
</article>
