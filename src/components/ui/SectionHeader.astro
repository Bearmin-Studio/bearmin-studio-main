---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
};

const { eyebrow, title, description, align = 'left', tone = 'light' } = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
const toneEyebrow = tone === 'dark' ? 'text-accent' : 'text-accent-deep';
const toneTitle = tone === 'dark' ? 'text-paper-soft' : 'text-ink';
const toneDesc = tone === 'dark' ? 'text-paper-soft/80' : 'text-ink-soft';
---

<div class:list={['max-w-3xl', alignClass]}>
  {
    eyebrow && (
      <p class:list={['text-xs font-semibold uppercase tracking-[0.22em]', toneEyebrow]}>
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'mt-3 text-xl font-bold leading-[1.4] tracking-tight md:text-2xl lg:text-3xl',
      toneTitle,
    ]}
  >
    <Fragment set:html={title} />
  </h2>
  {
    description && (
      <p class:list={['mt-4 text-pretty text-sm leading-[1.95] md:text-base', toneDesc]}>
        <Fragment set:html={description} />
      </p>
    )
  }
</div>
