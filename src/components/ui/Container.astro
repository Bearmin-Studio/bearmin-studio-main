---
type Props = {
  as?: 'div' | 'section' | 'article' | 'header' | 'footer';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
};

const { as: Tag = 'div', size = 'lg', class: className = '' } = Astro.props;

const sizeClass: Record<NonNullable<Props['size']>, string> = {
  sm: 'max-w-3xl',
  md: 'max-w-4xl',
  lg: 'max-w-7xl',
  xl: 'max-w-[88rem]',
};
---

<Tag class:list={['mx-auto w-full px-5 md:px-8', sizeClass[size], className]}>
  <slot />
</Tag>
