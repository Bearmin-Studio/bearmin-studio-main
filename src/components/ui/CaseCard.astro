---
import type { CaseStudy } from '../../data/cases';

type Props = {
  caseStudy: CaseStudy;
  size?: 'sm' | 'md';
};

const { caseStudy, size = 'md' } = Astro.props;
const padding = size === 'sm' ? 'p-6' : 'p-7 md:p-8';
---

<article class:list={['group flex h-full flex-col rounded-2xl border border-line bg-paper-soft transition-all duration-200 hover:-translate-y-0.5 hover:border-ink/30 hover:shadow-[var(--shadow-lift)]', padding]}>
  <div class="flex flex-wrap items-center gap-2">
    <span class="inline-flex items-center rounded-full bg-ink px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-paper-soft">
      {caseStudy.serviceLabel}
    </span>
    <span class="text-xs text-ink-muted">業種：{caseStudy.industry}</span>
  </div>
  <h3 class="mt-4 text-balance text-lg font-bold leading-snug md:text-xl">{caseStudy.title}</h3>
  <p class="mt-3 text-pretty text-sm leading-[1.9] text-ink-soft">{caseStudy.summary}</p>

  <div class="mt-6 divide-y divide-line text-sm text-ink-soft">
    <div class="py-4">
      <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Before</p>
      <p class="mt-1.5 leading-relaxed">{caseStudy.before}</p>
    </div>
    <div class="py-4">
      <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-accent-deep">After</p>
      <p class="mt-1.5 leading-relaxed">{caseStudy.after}</p>
    </div>
  </div>

  <div class="mt-6 flex items-baseline justify-between border-t border-line pt-5">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">効果</p>
    <p class="text-lg font-bold text-accent-deep md:text-xl">{caseStudy.metric}</p>
  </div>
  <p class="mt-1 text-right text-xs text-ink-muted">{caseStudy.metricDetail}</p>
</article>
