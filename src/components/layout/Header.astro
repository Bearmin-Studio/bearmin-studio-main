---
import { Image } from 'astro:assets';
import logoHorizontal from '../../assets/logo/logo-horizontal.png';
import { NAV_LINKS, CTA_LINK } from '../../lib/site';
import { COMPANY } from '../../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-paper-soft/85 backdrop-blur supports-[backdrop-filter]:bg-paper-soft/70"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-5 md:h-20 md:px-8">
    <a
      href="/"
      class="flex shrink-0 items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ink/40"
      aria-label="Bearmin Studio トップへ"
    >
      <Image
        src={logoHorizontal}
        alt="Bearmin Studio"
        widths={[140, 180, 240, 320]}
        sizes="(max-width: 768px) 120px, 180px"
        class="h-7 w-auto md:h-8"
      />
    </a>

    <nav aria-label="メインナビゲーション" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center px-3 py-2 text-sm font-medium transition-colors rounded-md',
                  'hover:text-ink hover:bg-line-soft/70',
                  isCurrent(link.href) ? 'text-ink' : 'text-ink-soft',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={CTA_LINK.href}
      class="ml-auto hidden md:inline-flex items-center gap-1.5 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper-soft transition-colors hover:bg-ink-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 focus-visible:ring-offset-2 focus-visible:ring-offset-paper-soft"
    >
      {CTA_LINK.label}
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4">
        <path
          fill-rule="evenodd"
          d="M7.21 14.77a.75.75 0 0 1 0-1.06L10.94 10 7.21 6.29a.75.75 0 1 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z"
          clip-rule="evenodd"
        />
      </svg>
    </a>

    <button
      type="button"
      class="ml-auto inline-flex h-10 w-12 items-center justify-center rounded-md text-ink transition-colors hover:bg-line-soft md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="メニューを開く"
      data-mobile-open
    >
      <svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="h-6 w-9">
        <path d="M1 6h30M1 12h30M1 18h30" />
      </svg>
    </button>
  </div>
</header>

<!-- Fullscreen mobile menu -->
<div
  id="mobile-nav"
  data-mobile-nav
  class="invisible fixed inset-0 z-50 flex flex-col bg-paper-soft opacity-0 transition-[opacity,visibility] duration-200 md:hidden"
  aria-hidden="true"
>
  <!-- Top bar inside fullscreen -->
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-line px-5">
    <a
      href="/"
      class="flex items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ink/40"
      aria-label="Bearmin Studio トップへ"
      data-mobile-link
    >
      <Image
        src={logoHorizontal}
        alt="Bearmin Studio"
        widths={[140, 180, 240]}
        sizes="120px"
        class="h-7 w-auto"
      />
    </a>
    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink transition-colors hover:bg-line-soft"
      aria-label="メニューを閉じる"
      data-mobile-close
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="h-6 w-6">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <!-- Nav links -->
  <nav aria-label="モバイルナビゲーション" class="flex-1 overflow-y-auto px-5 py-8">
    <ul class="flex flex-col">
      {
        NAV_LINKS.map((link) => (
          <li class="border-b border-line/60">
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              data-mobile-link
              class:list={[
                'flex items-center justify-between py-5 text-xl font-bold tracking-tight transition-colors',
                isCurrent(link.href) ? 'text-accent-deep' : 'text-ink hover:text-accent-deep',
              ]}
            >
              <span>{link.label}</span>
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4 text-ink-subtle">
                <path
                  fill-rule="evenodd"
                  d="M7.21 14.77a.75.75 0 0 1 0-1.06L10.94 10 7.21 6.29a.75.75 0 1 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={CTA_LINK.href}
      data-mobile-link
      class="mt-8 flex w-full items-center justify-center gap-1.5 rounded-full bg-ink px-5 py-4 text-base font-semibold text-paper-soft transition-colors hover:bg-ink-soft"
    >
      {CTA_LINK.label}
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4">
        <path
          fill-rule="evenodd"
          d="M7.21 14.77a.75.75 0 0 1 0-1.06L10.94 10 7.21 6.29a.75.75 0 1 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z"
          clip-rule="evenodd"
        />
      </svg>
    </a>

    <!-- Contact strip at bottom -->
    <div class="mt-12 border-t border-line pt-6">
      <p class="eyebrow-sm text-accent-deep">Contact</p>
      <ul class="mt-3 space-y-3 text-sm">
        <li>
          <a href={`mailto:${COMPANY.email}`} class="text-ink-soft transition-colors hover:text-ink" data-mobile-link>
            {COMPANY.email}
          </a>
        </li>
        <li>
          <a
            href={COMPANY.chatworkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-soft transition-colors hover:text-ink"
          >
            Chatwork: {COMPANY.chatworkId}
          </a>
        </li>
        <li>
          <a
            href={COMPANY.xUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-soft transition-colors hover:text-ink"
          >
            X: {COMPANY.xHandle}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</div>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-mobile-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-close]');
  const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]');

  function openMenu() {
    if (!nav || !openBtn) return;
    nav.classList.remove('invisible', 'opacity-0');
    nav.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    if (!nav || !openBtn) return;
    nav.classList.add('invisible', 'opacity-0');
    nav.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  links.forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.getAttribute('aria-hidden') === 'false') closeMenu();
  });
</script>
