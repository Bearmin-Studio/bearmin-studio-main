---
---

<section class="relative overflow-hidden text-paper-soft">
  <div class="absolute inset-0 -z-10 bg-ink" aria-hidden="true"></div>
  <canvas
    data-hero-canvas
    class="absolute inset-0 z-0 h-full w-full opacity-80 motion-reduce:hidden"
    aria-hidden="true"
  ></canvas>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-32 bg-linear-to-b from-transparent to-ink"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-5 py-14 md:px-8 md:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="break-keep text-balance text-[clamp(2rem,4.5vw,3rem)] font-bold leading-[1.3] tracking-tight">
        <span class="inline-block">さあ、</span><wbr />業務を<span class="inline-block"><span class="text-accent">自動化</span>しよう。</span>
      </h1>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <li class="inline-flex items-center gap-1.5 rounded-full border border-paper-soft/15 bg-paper-soft/10 px-3.5 py-1.5 text-xs font-semibold text-paper-soft backdrop-blur md:text-sm">
          # Excel・スプレッドシート自動化
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-paper-soft/15 bg-paper-soft/10 px-3.5 py-1.5 text-xs font-semibold text-paper-soft backdrop-blur md:text-sm">
          # 業務システム構築
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-paper-soft/15 bg-paper-soft/10 px-3.5 py-1.5 text-xs font-semibold text-paper-soft backdrop-blur md:text-sm">
          # RPA導入
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReducedMotion) {
    const ACCENT = new THREE.Color('#d4a574');

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
    camera.position.set(0, 0, 14);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const NODE_COUNT = isMobile ? 60 : 110;
    const RADIUS = 11;
    const LINK_DIST = isMobile ? 2.4 : 2.6;

    const positions = new Float32Array(NODE_COUNT * 3);
    const velocities = new Float32Array(NODE_COUNT * 3);

    for (let i = 0; i < NODE_COUNT; i++) {
      const r = Math.cbrt(Math.random()) * RADIUS;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      positions[i * 3 + 0] = r * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta) * 0.55;
      positions[i * 3 + 2] = r * Math.cos(phi);

      velocities[i * 3 + 0] = (Math.random() - 0.5) * 0.004;
      velocities[i * 3 + 1] = (Math.random() - 0.5) * 0.004;
      velocities[i * 3 + 2] = (Math.random() - 0.5) * 0.004;
    }

    const pointsGeometry = new THREE.BufferGeometry();
    pointsGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const pointsMaterial = new THREE.PointsMaterial({
      color: ACCENT,
      size: 0.09,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.95,
      depthWrite: false,
    });
    const points = new THREE.Points(pointsGeometry, pointsMaterial);
    scene.add(points);

    const MAX_LINK_VERTICES = NODE_COUNT * 12;
    const linkPositions = new Float32Array(MAX_LINK_VERTICES * 3);
    const linkColors = new Float32Array(MAX_LINK_VERTICES * 3);
    const linkGeometry = new THREE.BufferGeometry();
    linkGeometry.setAttribute('position', new THREE.BufferAttribute(linkPositions, 3));
    linkGeometry.setAttribute('color', new THREE.BufferAttribute(linkColors, 3));
    const linkMaterial = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.6,
    });
    const links = new THREE.LineSegments(linkGeometry, linkMaterial);
    scene.add(links);

    const group = new THREE.Group();
    group.add(points);
    group.add(links);
    scene.add(group);

    let pointerX = 0;
    let pointerY = 0;
    let targetRotX = 0;
    let targetRotY = 0;

    window.addEventListener('pointermove', (e) => {
      pointerX = (e.clientX / window.innerWidth) * 2 - 1;
      pointerY = (e.clientY / window.innerHeight) * 2 - 1;
    });

    function resize() {
      const parent = canvas.parentElement;
      if (!parent) return;
      const { clientWidth: w, clientHeight: h } = parent;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    const tmpA = new THREE.Vector3();
    const tmpB = new THREE.Vector3();

    let raf = 0;
    let visible = true;

    function tick(time: number) {
      const t = time * 0.0001;

      const posAttr = pointsGeometry.getAttribute('position') as THREE.BufferAttribute;
      const posArr = posAttr.array as Float32Array;

      for (let i = 0; i < NODE_COUNT; i++) {
        const ix = i * 3;
        posArr[ix + 0] += velocities[ix + 0];
        posArr[ix + 1] += velocities[ix + 1];
        posArr[ix + 2] += velocities[ix + 2];

        for (let k = 0; k < 3; k++) {
          const v = posArr[ix + k];
          const limit = k === 1 ? RADIUS * 0.6 : RADIUS;
          if (v > limit || v < -limit) velocities[ix + k] *= -1;
        }
      }
      posAttr.needsUpdate = true;

      let lc = 0;
      const linkDistSq = LINK_DIST * LINK_DIST;
      for (let i = 0; i < NODE_COUNT; i++) {
        tmpA.set(posArr[i * 3], posArr[i * 3 + 1], posArr[i * 3 + 2]);
        for (let j = i + 1; j < NODE_COUNT; j++) {
          tmpB.set(posArr[j * 3], posArr[j * 3 + 1], posArr[j * 3 + 2]);
          const dx = tmpA.x - tmpB.x;
          const dy = tmpA.y - tmpB.y;
          const dz = tmpA.z - tmpB.z;
          const dsq = dx * dx + dy * dy + dz * dz;
          if (dsq < linkDistSq && lc + 2 <= MAX_LINK_VERTICES) {
            const alpha = 1 - Math.sqrt(dsq) / LINK_DIST;
            const idxA = lc * 3;
            linkPositions[idxA + 0] = tmpA.x;
            linkPositions[idxA + 1] = tmpA.y;
            linkPositions[idxA + 2] = tmpA.z;
            linkColors[idxA + 0] = ACCENT.r * alpha;
            linkColors[idxA + 1] = ACCENT.g * alpha;
            linkColors[idxA + 2] = ACCENT.b * alpha;
            const idxB = (lc + 1) * 3;
            linkPositions[idxB + 0] = tmpB.x;
            linkPositions[idxB + 1] = tmpB.y;
            linkPositions[idxB + 2] = tmpB.z;
            linkColors[idxB + 0] = ACCENT.r * alpha;
            linkColors[idxB + 1] = ACCENT.g * alpha;
            linkColors[idxB + 2] = ACCENT.b * alpha;
            lc += 2;
          }
        }
      }
      linkGeometry.setDrawRange(0, lc);
      (linkGeometry.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
      (linkGeometry.getAttribute('color') as THREE.BufferAttribute).needsUpdate = true;

      targetRotX += (pointerY * 0.15 - targetRotX) * 0.04;
      targetRotY += (pointerX * 0.2 - targetRotY) * 0.04;
      group.rotation.x = targetRotX + Math.sin(t * 0.6) * 0.05;
      group.rotation.y = targetRotY + t * 0.8;

      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (!visible) return;
      if (!raf) raf = requestAnimationFrame(tick);
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          visible = entry.isIntersecting;
          if (visible) start();
          else stop();
        }
      },
      { threshold: 0 },
    );
    io.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }
</script>
