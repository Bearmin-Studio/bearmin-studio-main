  { orderNo: 'R-1035', customer: '株式会社L', product: '導入支援パック', amount: '¥480,000' },
  { orderNo: 'R-1036', customer: '株式会社M', product: '追加ライセンス', amount: '¥165,000' },
  { orderNo: 'R-1037', customer: '株式会社N', product: 'API連携プラン', amount: '¥340,000' },
  { orderNo: 'R-1038', customer: '株式会社O', product: '月次レポート作成', amount: '¥75,000' },
  { orderNo: 'R-1039', customer: '株式会社P', product: 'コンサルティング', amount: '¥860,000' },
  { orderNo: 'R-1040', customer: '株式会社Q', product: 'バックアップ運用', amount: '¥45,000' },
  { orderNo: 'R-1041', customer: '株式会社R', product: 'セキュリティ監査', amount: '¥280,000' },
  { orderNo: 'R-1042', customer: '株式会社S', product: '定期保守プラン', amount: '¥220,000' },
  { orderNo: 'R-1043', customer: '株式会社T', product: 'ユーザートレーニング', amount: '¥120,000' },
  { orderNo: 'R-1044', customer: '株式会社U', product: '導入支援パック', amount: '¥480,000' },
  { orderNo: 'R-1045', customer: '株式会社V', product: '追加ライセンス', amount: '¥98,000' },
  { orderNo: 'R-1046', customer: '株式会社W', product: 'データ移行サービス', amount: '¥390,000' },
  { orderNo: 'R-1047', customer: '株式会社X', product: 'コンサルティング', amount: '¥540,000' },
  { orderNo: 'R-1048', customer: '株式会社Y', product: '月次レポート作成', amount: '¥75,000' },
  { orderNo: 'R-1049', customer: '株式会社Z', product: 'API連携プラン', amount: '¥340,000' },
