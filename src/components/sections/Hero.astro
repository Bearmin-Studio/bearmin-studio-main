  { orderNo: 'R-1028', customer: '株式会社E', product: 'API連携プラン', amount: '¥340,000' },
  { orderNo: 'R-1029', customer: '株式会社F', product: 'コンサルティング', amount: '¥620,000' },
  { orderNo: 'R-1030', customer: '株式会社G', product: 'バックアップ運用', amount: '¥45,000' },
