---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import CharacterMascot from '../ui/CharacterMascot.astro';
import { COMPANY, SITE } from '../../lib/site';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = '<span class="inline-block">業務の自動化、</span><span class="inline-block">まずは一言から。</span>',
  description = '<span class="inline-block">お問い合わせフォーム、または Chatwork から</span><span class="inline-block">「相談したい」と一行送るだけで大丈夫です。</span><span class="inline-block">内容を整理しながらお返事します。</span>',
} = Astro.props;
---

<section class="bg-ink text-paper-soft">
  <Container class="grid items-center gap-10 py-20 md:grid-cols-[1.4fr_1fr] md:py-28">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">{SITE.tagline}</p>
      <h2 class="mt-4 text-3xl font-bold leading-[1.3] tracking-tight md:text-4xl lg:text-5xl"><Fragment set:html={title} /></h2>
      <p class="mt-6 max-w-xl text-pretty text-sm leading-[1.95] text-paper-soft/80 md:text-base"><Fragment set:html={description} /></p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/contact" variant="invert" size="lg">お問い合わせフォーム</Button>
        <Button
          href={COMPANY.chatworkUrl}
          variant="ghost"
          size="lg"
          class="!border-paper-soft/30 !text-paper-soft hover:!bg-paper-soft hover:!text-ink"
          target="_blank"
          rel="noopener noreferrer"
        >
          Chatworkで相談（{COMPANY.chatworkId}）
        </Button>
      </div>
    </div>
    <div class="flex justify-center md:justify-end">
      <CharacterMascot pose="bow" alt="" size="lg" class="drop-shadow-[0_20px_30px_rgba(0,0,0,0.45)]" />
    </div>
  </Container>
</section>
