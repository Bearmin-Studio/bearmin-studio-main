---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { RESULTS, RESULT_SUMMARY } from '../../data/results';

type Props = {
  spacing?: 'sm' | 'md' | 'lg';
};

const { spacing = 'lg' } = Astro.props;
---

<Section tone="paper" spacing={spacing}>
  <Container>
    <SectionHeader
      eyebrow="Results"
      title="業務効率化の効果"
      description="過去にお手伝いした業務自動化の代表例です。業務内容や規模により効果は異なりますが、月10〜30時間の作業時間削減につながるケースが多くあります。"
    />

    <div class="mt-12 overflow-hidden rounded-2xl border border-line bg-paper-soft">
      <table class="w-full text-left text-sm md:text-[15px]">
        <thead class="hidden bg-line-soft text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted md:table-header-group">
          <tr>
            <th scope="col" class="px-6 py-4">カテゴリ</th>
            <th scope="col" class="px-6 py-4">内容</th>
            <th scope="col" class="px-6 py-4 text-right">効果</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            RESULTS.map((row) => (
              <tr class="block py-5 md:table-row md:py-0">
                <td class="block px-6 pt-1 align-middle md:table-cell md:py-5">
                  <span class="inline-flex items-center rounded-full bg-line-soft px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
                    {row.categoryLabel}
                  </span>
                </td>
                <td class="block px-6 pt-3 align-middle text-ink md:table-cell md:py-5">
                  <p class="font-semibold">{row.title}</p>
                  {row.effectDetail && (
                    <p class="mt-1 text-xs text-ink-muted md:text-sm">{row.effectDetail}</p>
                  )}
                </td>
                <td class="block px-6 pt-3 text-left align-middle md:table-cell md:py-5 md:text-right">
                  <span class="text-base font-bold text-accent-deep md:text-lg">{row.effect}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-pretty text-center text-sm text-ink-muted md:text-[15px]">
      <span class="inline-block"><span class="font-semibold text-ink">{RESULT_SUMMARY.totalReduction}</span>の作業時間削減につながるケースも。</span>
      <span class="inline-block">人件費・外注費の削減にも直結します。</span>
    </p>
  </Container>
</Section>
