---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import CaseCard from '../ui/CaseCard.astro';
import Button from '../ui/Button.astro';
import { CASES } from '../../data/cases';

const preview = CASES.slice(0, 2);
---

<Section tone="paper" spacing="lg">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeader
        eyebrow="Cases"
        title="事例紹介"
        description="代表的な事例をご紹介します。業種を問わず、Excel／PC作業がある業務であれば対応可能です。"
      />
      <Button href="/cases" variant="ghost">すべての事例</Button>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-2 md:gap-8">
      {preview.map((c) => <CaseCard caseStudy={c} />)}
    </div>
  </Container>
</Section>
